# ChainGuardian Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# OpenRouter API Configuration
# ============================================================================
# Get your API key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================================
# Algorand Configuration
# ============================================================================
# Network: localnet, testnet, or mainnet
ALGORAND_NETWORK=testnet

# Algod Client Configuration
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_PORT=443
ALGOD_TOKEN=

# Indexer Client Configuration
INDEXER_SERVER=https://testnet-idx.algonode.cloud
INDEXER_PORT=443
INDEXER_TOKEN=

# ============================================================================
# GuardianVault Contract Configuration
# ============================================================================
# Set these after deploying the contract
CONTRACT_APP_ID=
CONTRACT_OWNER_ADDRESS=
AI_AUTHORIZER_ADDRESS=

# ============================================================================
# Database Configuration
# ============================================================================
# SQLite database URL
DATABASE_URL=sqlite+aiosqlite:///./chainguardian.db

# ============================================================================
# API Configuration
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Security Configuration
# ============================================================================
# Change this in production!
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
